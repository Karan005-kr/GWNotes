NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=studyvault

JWT_SECRET=change_this_to_a_long_random_secret_before_deployment
