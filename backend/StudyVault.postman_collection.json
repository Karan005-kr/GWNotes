{
  "info": {
    "name": "StudyVault Backend Pro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
        { "name": "Universities", "request": { "method": "GET", "url": "{{baseUrl}}/api/universities" } },
        { "name": "DCRUST Courses", "request": { "method": "GET", "url": "{{baseUrl}}/api/universities/dcrust/courses" } },
        { "name": "Search DBMS", "request": { "method": "GET", "url": "{{baseUrl}}/api/search?q=dbms" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const json = pm.response.json();", "if (json.data && json.data.token) pm.collectionVariables.set('token', json.data.token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@studyvault.local\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/dashboard"
          }
        },
        {
          "name": "List Subjects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/subjects?page=1&limit=20"
          }
        },
        {
          "name": "List Materials",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/materials?page=1&limit=20"
          }
        }
      ]
    }
  ]
}
